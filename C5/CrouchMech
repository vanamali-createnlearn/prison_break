-- LocalScript inside StarterPlayerScripts
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- SETTINGS
local crouchAnimId = "rbxassetid://106409501276734" -- crouch animation ID
local normalWalkSpeed = 16
local crouchWalkSpeed = 8

-- ANIMATION
local crouchAnim = Instance.new("Animation")
crouchAnim.AnimationId = crouchAnimId
local crouchTrack = humanoid:LoadAnimation(crouchAnim)
crouchTrack.Priority = Enum.AnimationPriority.Action

local crouching = false

-- FUNCTION: Check if player is Prisoner
local function isPrisoner()
	return player.Team and player.Team.Name == "Prisoners"
end

-- CROUCH INPUT
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	-- Prisoners only
	if not isPrisoner() then return end

	if input.KeyCode == Enum.KeyCode.C then
		if crouching then
			-- Stand up
			crouching = false
			humanoid.WalkSpeed = normalWalkSpeed
			if crouchTrack.IsPlaying then
				crouchTrack:Stop()
			end
		else
			-- Crouch
			crouching = true
			humanoid.WalkSpeed = crouchWalkSpeed
			crouchTrack:Play()
		end
	end
end)

-- HANDLE RESPAWN
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	crouchTrack = humanoid:LoadAnimation(crouchAnim)
end)
